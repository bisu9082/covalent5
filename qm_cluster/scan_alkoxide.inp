    {C 41 C}
    {C 42 C}
    {C 48 C}
    {C 53 C}
    {C 56 C}
    {C 57 C}
    {C 58 C}
    {C 59 C}
    {C 60 C}
    {C 61 C}
    {C 62 C}
    {C 63 C}
    {C 64 C}
    {C 65 C}
    {C 66 C}
    {C 67 C}
    {C 68 C}
   end
 end
* xyzfile -1 1 rc_alkoxide.xyz
