# covalent5 VX(P3S) alkoxide P...Ogamma scan 3.3->1.6A. net charge -1.
! wB97X-D3 def2-SVP def2/J RIJCOSX LooseOpt CPCM(water) TightSCF defgrid2
%pal nprocs 8 end
%maxcore 3500
%geom
  Scan B 29 1 = 3.30, 1.60, 18 end
