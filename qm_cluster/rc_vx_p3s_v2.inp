# covalent5 VX(P3S) 반응물 클러스터 최적화 v2 — 구속 강화
# 삼중쌍 Cbeta+capH 고정(0based 0,5,6,16,17,26) + P(30)-Ser Ogamma(1) 거리 3.3A 구속
# 순전하 -1, 닫힌껍질. 드리프트 방지 -> 수렴 목적.
! wB97X-D3 def2-SVP def2/J RIJCOSX OPT CPCM(water) TightSCF defgrid2
%pal nprocs 8 end
%maxcore 3500
%geom Constraints
  {C 0 C}
  {C 5 C}
  {C 6 C}
  {C 16 C}
  {C 17 C}
  {C 26 C}
  {B 30 1 3.30 C}
 end end
* xyzfile -1 1 cluster_reactant.xyz
